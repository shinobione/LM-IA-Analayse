LMN_APP_NAME=LMNotebook Deep Audio API
LMN_VERSION=2.0.0-alpha
LMN_NODE_NAME=RTX3060-PRIMARY
LMN_NODE_ROLE=coordinator
LMN_MAX_UPLOAD_MB=250

# Comma-separated browser origins allowed to call the API.
LMN_ALLOWED_ORIGINS=https://shinobione.github.io,http://127.0.0.1:8008,http://localhost:8008

# LAN workers. Example for the RTX 3070 Ti machine:
# LMN_WORKERS=http://192.168.1.50:8001
LMN_WORKERS=

# Override only if FFmpeg is not available in PATH.
LMN_FFMPEG_BIN=ffmpeg
LMN_FFPROBE_BIN=ffprobe
